# Target login is done manually in the browser (run test_login.py once).
# The session is stored in a dedicated Chrome profile (default: ./chrome-profile).
# CHROME_PROFILE_DIR=

# Optional Configuration
# Uncomment and modify these if you want to override the defaults in the script
# CHECK_INTERVAL=60  # Time in seconds between stock checks
# MAX_RETRIES=3      # Maximum number of purchase attempts if errors occur

# Email Notification Settings (Optional)
# Uncomment and fill these in if you want to receive email notifications
# NOTIFICATION_EMAIL=your_email@example.com
# EMAIL_PASSWORD=your_email_password
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587 
# =========================================================
# Python .gitignore (robust)
# =========================================================

# -------------------------
# Byte-compiled / cache
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
*.pyc

# C extensions / build artifacts
*.o
*.a
*.dylib
*.dll
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
share/python-wheels/

# -------------------------
# Virtual environments
# -------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
.conda/
miniconda/
anaconda/

# -------------------------
# Packaging / installers
# -------------------------
*.manifest
*.spec
MANIFEST
Pipfile.lock
poetry.lock

# -------------------------
# Testing / coverage
# -------------------------
.pytest_cache/
.cache/
.tox/
.nox/
.coverage
.coverage.*
.coverage.xml
htmlcov/
coverage.xml
*.cover
.hypothesis/
.hypothesis-cache/
nosetests.xml
nosetests.xml.*
junit/
junit.xml
test-results/
test-results.xml
.pytest_cache/

# -------------------------
# Type checkers / linters
# -------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pylint.d/
.pylintrc.local

# -------------------------
# Jupyter / IPython
# -------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints/
profile_default/
ipython_config.py

# -------------------------
# Documentation
# -------------------------
docs/_build/
docs/build/
site/
_site/
.mkdocs_build/
.cache/

# -------------------------
# Environment / secrets
# -------------------------
.env
.env.*
!.env.example
!.env.template
*.env
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
credentials.json
service-account.json
google-credentials.json
aws_credentials
.aws/
.azure/
.gcloud/
kubeconfig
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# -------------------------
# IDE / editors
# -------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
*.code-workspace

# -------------------------
# OS junk
# -------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# -------------------------
# Logs / databases / data
# -------------------------
*.log
logs/
log/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sql
data/
datasets/
models/
checkpoints/
*.h5
*.hdf5
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.tflite
*.joblib
*.npy
*.npz
*.parquet
*.feather
*.csv
*.tsv
*.xlsx
*.xls
!data/.gitkeep

# -------------------------
# Selenium / browser automation
# -------------------------
chromedriver
chromedriver.exe
geckodriver
geckodriver.exe
msedgedriver
msedgedriver.exe
selenium-debug.log
chrome-profile/
firefox-profile/
user-data/
cookies.txt
cookies.json
storage_state.json

# -------------------------
# Node (if mixed project)
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
.next/
.nuxt/
.cache/
.parcel-cache/

# -------------------------
# Misc
# -------------------------
*.bak
*.orig
*.rej
*.tmp
*.temp
*.pid
*.seed
*.pid.lock
.cache/
tmp/
temp/
login_debug.*
